# ==============================================================================
# 🚀 SkillForge AI — Unified Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env` in the project root.
# 2. Fill in the API keys and secrets provided by your teammates.
# 3. DO NOT commit `.env` to Git (it is already in .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. FRONTEND CONFIGURATION (Person 1 & Person 4)
# ------------------------------------------------------------------------------
# Base URL for the FastAPI Backend Server (Used by React Vite client)
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Optional Supabase Auth/Cloud fallback (if enabled)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# ⚙️ 2. CORE BACKEND & DATABASE CONFIGURATION (Person 2)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT Authentication tokens (Any secure random string)
JWT_SECRET_KEY=skillforge_super_secret_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite Database Connection (Defaults to local file skillforge.db)
DATABASE_URL=sqlite:///./skillforge.db

# ------------------------------------------------------------------------------
# 🧠 3. AI ENGINE & LLM SERVICES (Person 3 — Groq AI Engine)
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Get free from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Active Model: llama-3.3-70b-versatile (ultra-fast inference)
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Optional / Fallback)
GEMINI_API_KEY=your_gemini_api_key_here


